*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.patch text eol=lf
*.patch -whitespace
*.ps1 text eol=crlf
*.xls binary
*.png binary
*.pdf binary
# Preserve recorded evidence bytes so SHA-256 agrees on Windows and Linux.
evidence/** -text -whitespace
